# Freelancehunt API token — https://freelancehunt.com/my/api
FREELANCEHUNT_TOKEN=your_freelancehunt_api_token

# Dashboard login credentials (you choose these)
DASHBOARD_USER=admin
DASHBOARD_PASS=change_me

# Secret for signing the "remember me" auth cookie (any long random string)
# generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_random_hex

# Telegram bot token from @BotFather (optional — only for bot.py)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# По: AI-ставки (OpenAI Responses API)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna
# Твой Telegram user id: бот отвечает только ему (необязательно, иначе привязка по первому /start)
OWNER_TELEGRAM_ID=
STATE_PATH=data/state.json
